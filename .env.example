# Copiar este archivo a ".env" y completar con tus valores reales.
# El archivo ".env" NUNCA debe subirse a Git (ver .gitignore).

# Base de datos (phpMyAdmin / MySQL de XAMPP)
DB_HOST=localhost
DB_NAME=repositorio_inteligente
DB_USER=root
DB_PASS=

# API de Inteligencia Artificial (clasificación, resumen, extracción, respuestas)
# Proveedor: "anthropic" u "openai"
IA_PROVEEDOR=anthropic
IA_API_KEY=coloca_aqui_tu_api_key
IA_MODEL=claude-sonnet-4-6

# Embeddings para la búsqueda semántica / RAG (opcional).
# Si se deja vacío, el sistema usa un embedding local simplificado
# (hashing de texto) para que el flujo funcione sin costo durante las pruebas.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# Aplicación
APP_URL=http://localhost/repositorio-inteligente/public
APP_DEBUG=true
